  "css_selectors": "Exact root token, descendants/children only; sgn- classes, root-prefixed IDs, listed tags, simple focus/hover/structural pseudos; no CSS attribute selectors, escapes, sibling combinators or functional selector pseudos.",
  "media_queries": [
    "min/max-width in px",
    "screen",
    "print",
    "all",
    "prefers-reduced-motion:reduce/no-preference",
    "orientation:portrait/landscape"
  ],
