  "resources": "No CSS resources/external fonts/scripts/embeds/images/inline styles. HTTP(S) source/navigation links permitted; SVG geometry/text/local marker references only.",
  "source_storage": "Protected _sgnews_source_html; custom article.content_raw is authoritative, core post_content is safe fallback.",
  "identity": {
    "owner_user_id": 5,
    "dedicated_capability": "sgnews_publish",
    "auto_capability_grant": false
  },
  "preview": "Authenticated GET /articles/{id}/preview returns full native-theme HTML and identity/source/code binding; no bearer URLs or general editing grant."
